        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが解析中となるのは、映像フレームと必要なモデルが正常な場合のみです。"
          }
        }
      }
    },
    "A different authorized reviewer must approve the profile before it can be used.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different authorized reviewer must approve the profile before it can be used."
