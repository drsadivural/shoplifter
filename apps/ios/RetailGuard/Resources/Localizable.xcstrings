        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールを使用するには、別の権限を持つ確認者による承認が必要です。"
          }
        }
      }
    },
    "A required service is temporarily unavailable.": {
      "extractionState": "manual",
