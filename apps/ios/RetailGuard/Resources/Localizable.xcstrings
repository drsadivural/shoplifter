{
  "sourceLanguage": "en",
  "strings": {
    "%@ (you)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (you)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（自分）"
          }
        }
      }
    },
    "%@ coverage gap(s): results cannot include these periods.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ coverage gap(s): results cannot include these periods."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視対象外の期間が%@件あります。これらの期間は結果に含まれません。"
          }
        }
      }
    },
    "%@ is locked after failed attempts. Unlock your iPhone with its passcode, then try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is locked after failed attempts. Unlock your iPhone with its passcode, then try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証の失敗が続いたため、%@がロックされています。パスコードでiPhoneのロックを解除してから、しばらくしてもう一度お試しください。"
          }
        }
      }
    },
    "%@ is not set up on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not set up on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では%@が設定されていません。"
          }
        }
      }
    },
    "%@ is not set up on this device. You can set it up in Settings and turn it on later in Account & security.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not set up on this device. You can set it up in Settings and turn it on later in Account & security."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では%@が設定されていません。設定アプリで設定した後、「アカウントとセキュリティ」で有効にできます。"
          }
        }
      }
    },
    "%@ open alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ open alerts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未対応アラート %@件"
          }
        }
      }
    },
    "%@ outcome draft(s) are kept on this device. After you sign in, each is refreshed against the current incident before it can be submitted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ outcome draft(s) are kept on this device. After you sign in, each is refreshed against the current incident before it can be submitted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認結果の下書きが%@件この端末に保存されています。ログイン後、送信前にそれぞれ最新の事案と照らし合わせて更新されます。"
          }
        }
      }
    },
    "%@ owns this incident. You can add notes; only the owner can record the outcome.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ owns this incident. You can add notes; only the owner can record the outcome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この事案は%@が担当しています。メモは追加できますが、確認結果を記録できるのは担当者のみです。"
          }
        }
      }
    },
    "%@ photos · %@ approved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ photos · %@ approved"
