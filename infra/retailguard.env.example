# Copy to /etc/retailguard/retailguard.env (chmod 600). Generate secrets with:
#   openssl rand -base64 32        (keys)      openssl rand -hex 24   (passwords)
# Never commit the real file.
APP_ENV=production
WEB_ORIGIN=https://shoplifter.ayonix.com
POSTGRES_SUPERUSER_PASSWORD=
RG_OWNER_PASSWORD=
RG_APP_PASSWORD=
RG_WORKER_PASSWORD=
MIGRATION_DATABASE_URL=postgresql://retailguard_owner:<RG_OWNER_PASSWORD>@127.0.0.1:8716/retailguard
DATABASE_URL=postgresql://retailguard_app:<RG_APP_PASSWORD>@127.0.0.1:8716/retailguard
WORKER_DATABASE_URL=postgresql://retailguard_worker:<RG_WORKER_PASSWORD>@127.0.0.1:8716/retailguard
MEDIA_DIR=/var/lib/retailguard/media
MEDIA_MASTER_KEY=
SECRETS_KEY=
SESSION_HOURS=12
COOKIE_SECURE=true
# Store camera networks the edge may provision (comma separated CIDRs). Empty = any private range.
EDGE_ALLOWED_SUBNETS=
SUPPORT_CONTACT=
# Optional integrations — leave empty until real credentials exist (features report "unconfigured").
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_FILE=
APNS_BUNDLE_ID=
AYONIX_SDK_PACKAGE=
AYONIX_LICENSE_FILE=
